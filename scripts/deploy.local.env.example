# Copy to scripts/deploy.local.env (gitignored) and edit.
# Real environment variables override these values.

# ── SSH setup (one-time; lets Windows connect to the server without a password) ──
# Replace "me" with your Linux user name and "my-server" with the server IP/domain.
#
# 1. Create a security key — in Windows PowerShell, if you do not already have one:
#      ssh-keygen -t ed25519
#    Press Enter three times (default location, no key password).
#
# 2. Copy the public key to the server (PowerShell has no ssh-copy-id):
#      type $env:USERPROFILE\.ssh\id_ed25519.pub | ssh me@my-server "cat >> ~/.ssh/authorized_keys"
#    Type your Linux server password when asked. (In Git Bash: ssh-copy-id me@my-server)
#
# 3. Test: the command must print "ok" with no password prompt:
#      ssh me@my-server echo ok
#
# Optional — short name: create/edit C:\Users\<YourWindowsUser>\.ssh\config in Notepad:
#      Host testbox
#        HostName my-server
#        User me
#    Then use DEPLOY_HOST=testbox below.
#
# You can skip all of this and use your normal server password; then every deploy
# asks for it twice. A security key is faster and more secure.

# SSH target: user@host, or an alias from ~/.ssh/config.
DEPLOY_HOST=user@my-server

# Image name and tag rules:
#   DEPLOY_OVERWRITE=true  -> fixed tag, every deploy replaces it, old image pruned server-side
#   DEPLOY_OVERWRITE=false -> tag = sha-<short git sha>, each commit keeps its own image
DEPLOY_IMAGE=sublarr
DEPLOY_TAG=
DEPLOY_OVERWRITE=true

# Empty builds for this machine's arch (linux/amd64). Set for a cross-build,
# e.g. linux/arm64 for an ARM server (uses buildx + QEMU).
DEPLOY_PLATFORM=

# Optional: on the server, restart the stack after the image loads
# (`docker compose up -d --force-recreate`). With DEPLOY_OVERWRITE=true the tag
# stays constant, so the compose file on the server never needs editing.
DEPLOY_COMPOSE_DIR=

# Optional command run on the server after the image is loaded, overrides
# DEPLOY_COMPOSE_DIR, e.g.:
# DEPLOY_REMOTE_CMD="cd /opt/sublarr && VERSION=dev docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d"
DEPLOY_REMOTE_CMD=
